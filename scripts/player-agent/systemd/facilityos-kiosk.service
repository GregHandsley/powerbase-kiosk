[Unit]
Description=FacilityOS Kiosk (Chromium)
After=network-online.target facilityos-agent.service
Wants=network-online.target

[Service]
Type=simple
# Replace with your kiosk user (must match facilityos-agent.service)
User=greghandsley
WorkingDirectory=/home/greghandsley
Environment=DISPLAY=:0
# Wait for display/GPU to be ready at boot
ExecStartPre=/bin/sleep 10
ExecStart=/usr/bin/startx /home/greghandsley/kiosk.sh -- :0
Restart=always
RestartSec=5

# Note: No hardening here - kiosk needs full X/Chromium access (display, GPU, etc.)

[Install]
WantedBy=multi-user.target
