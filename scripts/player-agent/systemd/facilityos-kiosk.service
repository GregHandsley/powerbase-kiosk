[Unit]
Description=FacilityOS Kiosk (Chromium)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace with your kiosk user (must match facilityos-agent.service)
User=greghandsley
WorkingDirectory=/home/greghandsley
Environment=DISPLAY=:0
ExecStart=/usr/bin/startx /home/greghandsley/kiosk.sh -- :0
Restart=always
RestartSec=2

# Least-privilege hardening (Sprint 5.1)
# Kiosk needs X/display (AF_UNIX) and network - fewer restrictions than agent
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
