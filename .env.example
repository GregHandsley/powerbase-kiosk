# Required: Supabase project URL and anon (public) key.
# Get these from Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Sentry DSN for error tracking. Omit to disable.
# VITE_SENTRY_DSN=

# Optional: Force organisation for dev/preview (e.g. facilityos or loughboroughsport).
# VITE_ORG_OVERRIDE=facilityos
