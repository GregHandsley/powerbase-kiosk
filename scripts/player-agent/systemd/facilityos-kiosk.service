[Unit]
Description=FacilityOS Kiosk (Chromium)
After=network-online.target facilityos-agent.service
Wants=network-online.target

[Service]
Type=simple
# Replace with your kiosk user (must match facilityos-agent.service)
User=greghandsley
WorkingDirectory=/home/greghandsley
Environment=DISPLAY=:0
# Wait for display to be ready (X may already be running from autologin)
ExecStartPre=/bin/sleep 15
# Run kiosk directly - X is already active on :0 (no startx)
ExecStart=/home/greghandsley/facilityos/kiosk.sh
Restart=always
RestartSec=5

# Note: No hardening here - kiosk needs full X/Chromium access (display, GPU, etc.)

[Install]
WantedBy=multi-user.target
